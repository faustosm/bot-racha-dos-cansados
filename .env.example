# Copie para .env e preencha:  cp .env.example .env
# Gere os segredos com:        make secrets
# O .env NAO vai para o git.

# ---------------------------------------------------------------------------
# Geral
# ---------------------------------------------------------------------------
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Postgres (usado pela Evolution API e pelo bot, em databases separados)
# ---------------------------------------------------------------------------
POSTGRES_USER=racha
POSTGRES_PASSWORD=troque-esta-senha
# Database da Evolution API (criado automaticamente pela imagem do Postgres)
POSTGRES_DB=evolution
# Database do bot (criado por postgres/init/01-create-bot-db.sh)
BOT_DB=racha

# ---------------------------------------------------------------------------
# Evolution API
# ---------------------------------------------------------------------------
# Chave de acesso a API. O default do projeto e publico - SEMPRE troque.
# Gere com: openssl rand -hex 32
EVOLUTION_API_KEY=troque-esta-chave

# URL publica da API. No WSL/local pode deixar como esta.
# Na VPS, ajuste se for expor por dominio/proxy reverso.
EVOLUTION_SERVER_URL=http://localhost:8080

# Nome da instancia (a "conexao" de WhatsApp dentro da Evolution).
EVOLUTION_INSTANCE=racha

# Nome que aparece em "Dispositivos conectados" no celular do bot.
SESSION_PHONE_CLIENT=Racha

# WEBHOOKS e essencial para debugar entrega de eventos.
EVOLUTION_LOG_LEVEL=ERROR,WARN,INFO,WEBHOOKS

# ---------------------------------------------------------------------------
# Bot
# ---------------------------------------------------------------------------
# Segredo compartilhado: a Evolution envia no header do webhook e o bot valida.
# Gere com: openssl rand -hex 32
WEBHOOK_TOKEN=troque-este-token

BOT_LOG_LEVEL=info

# Numero do bot, so digitos com DDI (ex: 553497062526).
# Monta o link wa.me dos anuncios, que abre o privado com a mensagem
# preenchida - e como as pessoas comecam a falar com o bot sem salvar contato.
BOT_NUMERO=

# ---------------------------------------------------------------------------
# Regras do racha
# ---------------------------------------------------------------------------
# 20 vagas no total, das quais no MAXIMO 2 de goleiro. O teto de goleiro nao e
# cota reservada: com 1 goleiro inscrito, as 19 restantes podem ser de linha.
VAGAS_TOTAL=18

# Agendamento (horario local do container, TZ acima).
# ATENCAO: nao ponha comentario na mesma linha - o Compose leria o "#" como
# parte do valor e o cron ficaria invalido.
# quarta 12:00 - abre para os fixos
CRON_ABRE_FIXOS="0 12 * * 3"
# quinta 12:00 - libera convidados
CRON_ABRE_CONVIDADOS="0 12 * * 4"
# sabado 09:00 - fecha e publica a lista final
CRON_FECHA="0 7 * * 6"

# Quanto tempo uma pergunta do bot no privado continua valida (minutos).
CONVERSA_TTL_MIN=15

# JID do grupo do WhatsApp que o bot atende.
# Deixe VAZIO no primeiro boot: o bot vai logar o JID de qualquer grupo que
# receber mensagem, e ai voce copia o valor para ca e roda "make restart".
# Formato: 1234567890-1234567890@g.us  ou  123456789012345678@g.us
GROUP_JID=

# Telefone de quem administra o racha, formato 5511999999999@s.whatsapp.net.
# Deixe vazio para desligar. O bot manda um aviso no privado quando um voto
# de enquete se perde (enquete duplicada/desconhecida, ou falha ao decifrar) -
# sem isso o unico sinal fica escondido no log.
ADMIN_TELEFONE=

# ---------------------------------------------------------------------------
# Identidade do racha (aparece na enquete e nos anuncios)
# ---------------------------------------------------------------------------
RACHA_NOME=Racha
RACHA_LOCAL=
RACHA_ENDERECO=
RACHA_HORARIO="09:00 às 11:00"

# Sexta 08:00 - chamada geral se o time nao fechou
CRON_CHAMADA="0 8 * * 5"
# Quarta a sexta 19:00 - resumo diario da lista
CRON_DIGEST="0 19 * * 3-5"

# Avisar que as vagas estao acabando quando restarem N ou menos
ALERTA_VAGAS=2
# Minimo para o jogo acontecer (dispara a chamada de sexta)
MIN_JOGADORES=12
